{
  "entities": {
    "Work": {
      "title": "Work",
      "description": "A knitting, crochet, sewing or macrame work.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "description", "category", "imageUrl", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Work category (e.g. Ferri, Uncinetto).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    }
  },
  "firestore": {
    "/works/{workId}": {
      "schema": "Work",
      "description": "Collection of works."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of categories."
    }
  }
}
